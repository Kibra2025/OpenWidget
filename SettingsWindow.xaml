<Window x:Class="DeskHardwareWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Gestisci OpenWidget" Icon="/OpenWidget;component/Assets/App.ico" Width="960" Height="700" MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#15161C" Foreground="#E2E4EC" FontFamily="Segoe UI" FontSize="12"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2E4EC"/></Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/><Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1F212A"/><Setter Property="BorderBrush" Value="#2D303D"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E2E4EC"/><Setter Property="Background" Value="#252A38"/>
            <Setter Property="BorderBrush" Value="#3D455C"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#32394C"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Navigation" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="13,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#252A38"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#203242"/><Setter Property="Foreground" Value="#38BDF8"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E4EC"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="Track" Width="34" Height="20" CornerRadius="10" Background="#3D455C" VerticalAlignment="Center" BorderThickness="1" BorderBrush="Transparent">
                        <Ellipse x:Name="Thumb" Fill="#94A3B8" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left"/>
                    </Border>
                    <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Track" Property="Background" Value="#38BDF8"/>
                        <Setter TargetName="Thumb" Property="Fill" Value="#15161C"/>
                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E2E4EC"/><Setter Property="Background" Value="#15161C"/>
            <Setter Property="BorderBrush" Value="#3D455C"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="SelectionBrush" Value="#267A9D"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#38BDF8"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="Background" Value="#191B23"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="#3D455C" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#64748B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#323645" BorderThickness="1" CornerRadius="12" Background="#15161C">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#2D303D" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="34" Height="34" Source="/OpenWidget;component/Assets/AppIcon.png" Margin="0,0,12,0"/>
                        <StackPanel><TextBlock Text="OpenWidget" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="PANNELLO DI GESTIONE" FontSize="9" Foreground="#717688" Margin="0,3,0,0"/></StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Padding="12" ToolTip="Riduci a icona" AutomationProperties.Name="Riduci a icona" Click="Minimize_Click"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Background="Transparent" BorderThickness="0" Padding="12" ToolTip="Chiudi il pannello" AutomationProperties.Name="Chiudi il pannello" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#191B23" BorderBrush="#2D303D" BorderThickness="0,0,1,0">
                    <Grid Margin="14,22,14,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="PERSONALIZZA" FontSize="9" Foreground="#717688" Margin="13,0,0,12"/>
                            <RadioButton x:Name="NavCards" Style="{StaticResource Navigation}" GroupName="Section" Tag="Cards" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Temperature" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavBatteries" Style="{StaticResource Navigation}" GroupName="Section" Tag="Batteries" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE850;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Batterie" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Navigation}" GroupName="Section" Tag="Position" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Posizione" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Navigation}" GroupName="Section" Tag="General" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Impostazioni" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource Navigation}" GroupName="Section" Tag="Diagnostics" Checked="Navigation_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Sensori e diagnostica" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="#2D303D" BorderThickness="0,1,0,0" Padding="12,17,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,7,0"/><TextBlock Text="Widget in esecuzione" FontSize="11"/></StackPanel>
                                <TextBlock Text="Resta attivo chiudendo il pannello." Style="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,25,28,18">
                    <Grid>
                        <StackPanel x:Name="CardsPage">
                            <TextBlock Text="Temperature" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Scegli le GPU e le altre informazioni da mostrare sul desktop." Style="{StaticResource Muted}" Margin="0,0,0,23"/>
                            <Border Style="{StaticResource Card}"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#203242" CornerRadius="8" VerticalAlignment="Top">
                                    <Path Data="M4,4 H20 V20 H4 Z M7,7 H17 V17 H7 Z M2,9 H4 M2,15 H4 M20,9 H22 M20,15 H22 M9,2 V4 M15,2 V4 M9,20 V22 M15,20 V22" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.5" Width="19" Height="19"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="CPU" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="CpuName" Text="Processore" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="Sempre attiva" Foreground="#38BDF8" FontSize="10" VerticalAlignment="Center"/>
                            </Grid></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#30243D" CornerRadius="8" VerticalAlignment="Top">
                                    <Path Data="M3,5 H21 V19 H3 Z M6,8 H12 V16 H6 Z M15,8 H18 V11 H15 Z M15,13 H18 V16 H15 Z" Stretch="Uniform" Stroke="#C084FC" StrokeThickness="1.5" Width="19" Height="19"/>
                                </Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="GPU" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Visibilità indipendente per ogni scheda" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                <TextBlock x:Name="GpuSummary" Grid.Column="2" Foreground="#C084FC" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                                <ItemsControl x:Name="GpuOptions" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#2D303D" BorderThickness="0,1,0,0" Padding="0,12,0,12">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding Label}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                            <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding AccessibleName}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock x:Name="GpuEmpty" Text="Nessuna GPU rilevata. Le nuove schede appariranno qui automaticamente." Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,12" Visibility="Collapsed"/>
                                <WrapPanel><Button x:Name="ShowAllGpusButton" Content="Mostra tutte" Click="ShowAllGpus_Click" Padding="12,6" Margin="0,0,8,0"/><Button x:Name="HideAllGpusButton" Content="Nascondi tutte" Click="HideAllGpus_Click" Padding="12,6"/></WrapPanel>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#1F352E" CornerRadius="8"><Path Data="M2,6 H22 V18 H2 Z M5,9 H9 V15 H5 Z M12,9 H16 V15 H12 Z M5,18 V21 M10,18 V21 M15,18 V21 M20,18 V21" Stretch="Uniform" Stroke="#4ADE80" StrokeThickness="1.5" Width="19" Height="19"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="Memoria RAM" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Utilizzo e memoria disponibile" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                <CheckBox x:Name="ShowMemory" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Mostra memoria RAM" Checked="Control_Changed" Unchecked="Control_Changed"/>
                            </Grid></Border>
                            <Border Style="{StaticResource Card}"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" Background="#382E21" CornerRadius="8"><Path Data="M7,3 V21 M3,17 L7,21 11,17 M17,21 V3 M13,7 L17,3 21,7" Stretch="Uniform" Stroke="#FBBF24" StrokeThickness="1.5" Width="19" Height="19"/></Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="Rete" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Download, upload e scheda di rete" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                <CheckBox x:Name="ShowNetwork" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="Mostra rete" Checked="Control_Changed" Unchecked="Control_Changed"/>
                            </Grid></Border>
                            <Grid Margin="0,4,0,0"><TextBlock Text="La modalità compatta mantiene CPU e le GPU selezionate." Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,170,0"/>
                                <Button Content="Modalità compatta" HorizontalAlignment="Right" Click="Compact_Click"/></Grid>
                        </StackPanel>
                        <StackPanel x:Name="BatteriesPage" Visibility="Collapsed">
                            <TextBlock Text="Widget batterie" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Una finestra indipendente per PC e accessori, con posizione salvata separatamente." Style="{StaticResource Muted}" Margin="0,0,0,23"/>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <CheckBox x:Name="ShowBatteryWidget" Content="Mostra il widget batterie" FontWeight="SemiBold" Checked="Control_Changed" Unchecked="Control_Changed"/>
                                <Border Height="1" Background="#2D303D" Margin="0,16"/>
                                <CheckBox x:Name="ShowPcBattery" Content="Batteria del PC, se presente" Checked="Control_Changed" Unchecked="Control_Changed" Margin="0,0,0,13"/>
                                <CheckBox x:Name="ShowAccessoryBatteries" Content="Batterie degli accessori Bluetooth e altri dispositivi" Checked="Control_Changed" Unchecked="Control_Changed" Margin="0,0,0,13"/>
                                <CheckBox x:Name="ShowUnknownBattery" Content="Includi dispositivi con carica non disponibile" Checked="Control_Changed" Unchecked="Control_Changed" Margin="0,0,0,13"/>
                                <CheckBox x:Name="ShowDisconnectedBattery" Content="Includi dispositivi scollegati rilevati" Checked="Control_Changed" Unchecked="Control_Changed"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Dispositivi e aggiornamento" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BatteryDevicesSummary" Text="Lettura batterie in corso…" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,16"/>
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="BatteryRefreshInterval" Width="80" TextChanged="Control_Changed" AutomationProperties.Name="Intervallo batterie accessori in secondi"/><TextBlock Text="secondi tra le letture degli accessori" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                                <TextBlock Text="Da 10 a 300 s · PC aggiornato ogni 5 s" Style="{StaticResource Muted}" FontSize="10" Margin="0,8,0,14"/>
                                <Button Content="Aggiorna batterie adesso" HorizontalAlignment="Left" Click="RefreshBatteries_Click"/>
                                <TextBlock Text="DualSense e DualSense Edge: batteria e ricarica via Bluetooth o USB. MX Master e altri Logitech compatibili: lettura diretta anche tramite Bolt/Unifying. Gli altri accessori usano i dati di Windows. Il fulmine appare solo quando la ricarica è confermata; i dati mancanti restano sconosciuti." Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel x:Name="PositionPage" Visibility="Collapsed">
                            <TextBlock Text="Posizione sul desktop" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Sposta le finestre Temperature e Batterie in modo indipendente." Style="{StaticResource Muted}" Margin="0,0,0,23"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                                    <TextBlock Text="Temperature" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Posizione della finestra hardware." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,18"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Orizzontale · X" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><TextBox x:Name="PositionX" AutomationProperties.Name="Coordinata X · Temperature" TextChanged="Control_Changed"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Verticale · Y" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><TextBox x:Name="PositionY" AutomationProperties.Name="Coordinata Y · Temperature" TextChanged="Control_Changed"/></StackPanel>
                                    </Grid>
                                    <Button Content="Centra sul monitor principale" FontSize="11" Padding="10,9" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Center_Click"/>
                                    <Border Height="1" Background="#2D303D" Margin="0,18"/>
                                    <CheckBox x:Name="LockPosition" Content="Blocca posizione" Checked="Control_Changed" Unchecked="LockPosition_Unchecked" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="ClickThrough" Content="Click-through" Checked="ClickThrough_Checked" Unchecked="Control_Changed"/>
                                </StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><StackPanel>
                                    <TextBlock Text="Batterie" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Posizione della finestra batterie." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,18"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Orizzontale · X" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><TextBox x:Name="BatteryPositionX" AutomationProperties.Name="Coordinata X · Batterie" TextChanged="Control_Changed"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Verticale · Y" Style="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><TextBox x:Name="BatteryPositionY" AutomationProperties.Name="Coordinata Y · Batterie" TextChanged="Control_Changed"/></StackPanel>
                                    </Grid>
                                    <Button Content="Centra sul monitor principale" FontSize="11" Padding="10,9" HorizontalAlignment="Left" Margin="0,14,0,0" Click="CenterBattery_Click"/>
                                    <Border Height="1" Background="#2D303D" Margin="0,18"/>
                                    <CheckBox x:Name="LockBattery" Content="Blocca posizione" Checked="Control_Changed" Unchecked="LockBattery_Unchecked" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="BatteryClickThrough" Content="Click-through" Checked="BatteryClickThrough_Checked" Unchecked="Control_Changed"/>
                                </StackPanel></Border>
                            </Grid>
                            <TextBlock Text="Le coordinate vengono adattate all'area visibile dei monitor. Sono ammessi valori negativi per i monitor a sinistra o in alto." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12"/>
                            <TextBlock Text="Sblocca una finestra per trascinarla. Il click-through lascia passare i clic al desktop e si può disattivare anche dall'icona nell'area di notifica. Premi Applica per salvare." Style="{StaticResource Muted}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel x:Name="GeneralPage" Visibility="Collapsed">
                            <TextBlock Text="Impostazioni" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Avvio e aggiornamento del monitoraggio hardware." Style="{StaticResource Muted}" Margin="0,0,0,23"/>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Avvio con Windows" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                                <CheckBox x:Name="Autostart" Content="Avvia automaticamente come amministratore" Checked="Control_Changed" Unchecked="Control_Changed"/>
                                <TextBlock Text="Il widget si avvia al tuo accesso con i privilegi necessari per leggere i sensori hardware." Style="{StaticResource Muted}" FontSize="11" Margin="44,8,0,0"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Frequenza di aggiornamento" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Un intervallo più breve aggiorna i dati più spesso e richiede più risorse." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,15"/>
                                <StackPanel Orientation="Horizontal"><TextBox x:Name="RefreshInterval" Width="120" AutomationProperties.Name="Intervallo di aggiornamento in millisecondi" TextChanged="Control_Changed"/><TextBlock Text="millisecondi" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
                                <TextBlock Text="Da 250 a 60.000 ms · Valore consigliato: 1.000 ms" Style="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0"/>
                                <TextBlock Text="Il nuovo intervallo si applica senza riavviare il widget." Foreground="#38BDF8" FontSize="11" Margin="0,15,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
                            <TextBlock Text="Sensori e diagnostica" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Controlla le letture hardware e accedi agli strumenti di supporto." Style="{StaticResource Muted}" Margin="0,0,0,23"/>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Temperatura CPU" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="CpuSensorStatus" Text="In attesa della prima lettura…" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="DriverStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,14"/>
                                <Button x:Name="DriverButton" Content="Installa / aggiorna PawnIO" HorizontalAlignment="Left" Click="Driver_Click"/>
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="Strumenti" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <TextBlock Text="La nuova rilevazione riavvia il widget e ricrea l'elenco dei sensori." Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,13"/>
                                <WrapPanel><Button Content="Rileva di nuovo i sensori" Click="Rescan_Click" Margin="0,0,8,8"/><Button Content="Riavvia come amministratore" Click="Restart_Click" Margin="0,0,0,8"/></WrapPanel>
                                <Border Background="#2D303D" Height="1" Margin="0,8,0,16"/>
                                <Button Content="Apri log diagnostico" HorizontalAlignment="Left" Click="Log_Click"/>
                                <TextBlock x:Name="LogPath" Style="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#2D303D" BorderThickness="0,1,0,0" Background="#191B23" CornerRadius="0,0,12,12">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="Esci dal widget" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" Padding="0,9,8,9" VerticalAlignment="Center" Click="Exit_Click"/>
                    <TextBlock x:Name="SaveStatus" Grid.Column="1" Text="Tutte le modifiche sono salvate" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" Margin="16,0,18,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RevertButton" Content="Annulla modifiche" IsEnabled="False" Click="Revert_Click" Margin="0,0,8,0"/>
                        <Button x:Name="ApplyButton" Content="Applica" Background="#203242" BorderBrush="#38BDF8" Foreground="#38BDF8" FontWeight="SemiBold" MinWidth="92" IsEnabled="False" Click="Apply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
