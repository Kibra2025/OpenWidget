<UserControl x:Class="DeskHardwareWidget.GpuCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260" Height="132">
    <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="0" Margin="4" Padding="12,8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M3,5 H21 V19 H3 Z M6,8 H12 V16 H6 Z M15,8 H18 V11 H15 Z M15,13 H18 V16 H15 Z"
                          Stretch="Uniform" Stroke="#C084FC" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtTitle" Text="GPU" FontSize="13" FontWeight="SemiBold" Foreground="#E2E4EC"/>
                </StackPanel>
                <TextBlock Text="···" FontSize="16" Foreground="#717688" HorizontalAlignment="Right" Cursor="Hand" MouseDown="Dots_MouseDown"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtLoad" Text="— %" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="txtTemperature" Text="Temp. non disponibile" FontSize="11" Foreground="#94A3B8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtMemory" Text="Memoria non disponibile" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtName" FontSize="10" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Canvas Grid.Column="1" Height="48" VerticalAlignment="Center" ClipToBounds="True">
                    <Path x:Name="graphFill"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#55C084FC" Offset="0"/><GradientStop Color="#05C084FC" Offset="1"/>
                    </LinearGradientBrush></Path.Fill></Path>
                    <Path x:Name="graphLine" Stroke="#C084FC" StrokeThickness="2"/>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</UserControl>
