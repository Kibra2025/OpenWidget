<Window x:Class="DeskHardwareWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWidget"
        Icon="/OpenWidget;component/Assets/App.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <!-- Dark Context Menu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1C1E26"/>
            <Setter Property="BorderBrush" Value="#323645"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2E4EC"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E4EC"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2" Content="{TemplateBinding InputGestureText}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D3142"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666C80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#323645"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="MainWidgetBorder"
                Background="#F015161C"
                BorderBrush="#2E3240"
                BorderThickness="1"
                CornerRadius="16"
                Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical">

                <!-- Unlocked Banner (Only visible when unlocked for dragging) -->
                <Border x:Name="UnlockBanner"
                        Background="#252A38"
                        BorderBrush="#3D455C"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,5"
                        Margin="2,0,2,8"
                        Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔓" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Posizione sbloccata • Trascina il widget ovunque" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Content="📌 Blocca"
                                Click="BtnLockWidget_Click"
                                FontSize="11"
                                Foreground="#38BDF8"
                                Background="#1E2330"
                                BorderBrush="#38BDF8"
                                BorderThickness="1"
                                Padding="8,2"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <WrapPanel x:Name="CardsPanel" Width="520" ItemHeight="132">
                    <!-- CARD 1: CPU -->
                    <Border Width="252"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="0"
                            Margin="4"
                            Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- CPU Chip Icon -->
                                    <Path Data="M4,4 H20 V20 H4 Z M7,7 H17 V17 H7 Z M2,9 H4 M2,12 H4 M2,15 H4 M20,9 H22 M20,12 H22 M20,15 H22 M9,2 V4 M12,2 V4 M15,2 V4 M9,20 V22 M12,20 V22 M15,20 V22"
                                          Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Foreground="#E2E4EC" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="···" FontSize="16" Foreground="#717688" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseDown="DotsMenu_MouseDown"/>
                            </Grid>

                            <!-- Body: Stats + Sparkline -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCpuPercent" Text="0 %" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="txtCpuSubtitle" TextTrimming="CharacterEllipsis" Text="-- °C" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="txtCpuName" Text="Intel Core" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Sparkline Graph -->
                                <Canvas Grid.Column="1" Height="48" VerticalAlignment="Center" ClipToBounds="True">
                                    <Path x:Name="cpuGraphFill">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#5538BDF8" Offset="0.0"/>
                                                <GradientStop Color="#0538BDF8" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <Path x:Name="cpuGraphLine" Stroke="#38BDF8" StrokeThickness="2"/>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 3: Memory -->
                    <Border x:Name="cardMemory" Width="252"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="0"
                            Margin="4"
                            Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Memory RAM Icon -->
                                    <Path Data="M3,6 H21 V18 H3 Z M6,18 V15 M9,18 V15 M12,18 V15 M15,18 V15 M18,18 V15 M6,9 H18 V12 H6 Z"
                                          Stretch="Uniform" Stroke="#60A5FA" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Memory" FontSize="13" FontWeight="SemiBold" Foreground="#E2E4EC" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="···" FontSize="16" Foreground="#717688" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseDown="DotsMenu_MouseDown"/>
                            </Grid>

                            <!-- Body: Stats + Sparkline -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtRamPercent" Text="0 %" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="txtRamSubtitle" Text="-- / -- GB" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    <TextBlock Text="RAM di sistema" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Sparkline Graph -->
                                <Canvas Grid.Column="1" Height="48" VerticalAlignment="Center" ClipToBounds="True">
                                    <Path x:Name="ramGraphFill">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#5560A5FA" Offset="0.0"/>
                                                <GradientStop Color="#0560A5FA" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <Path x:Name="ramGraphLine" Stroke="#60A5FA" StrokeThickness="2"/>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 4: Network -->
                    <Border x:Name="cardNetwork" Width="252"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="0"
                            Margin="4"
                            Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Network Antenna / Globe Icon -->
                                    <Path Data="M12,2 A10,10 0 0,0 2,12 A10,10 0 0,0 12,22 A10,10 0 0,0 22,12 A10,10 0 0,0 12,2 Z M2,12 H22 M12,2 A15,15 0 0,0 12,22 M12,2 A15,15 0 0,1 12,22"
                                          Stretch="Uniform" Stroke="#FB7185" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Network" FontSize="13" FontWeight="SemiBold" Foreground="#E2E4EC" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="···" FontSize="16" Foreground="#717688" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseDown="DotsMenu_MouseDown"/>
                            </Grid>

                            <!-- Body: Stats + Sparkline -->
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtNetDown" Text="↓ 0 Kbps" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="txtNetUp" Text="↑ 0 Kbps" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="txtNetName" Text="Ethernet / Wi-Fi" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Sparkline Graph -->
                                <Canvas Grid.Column="1" Height="48" VerticalAlignment="Center" ClipToBounds="True">
                                    <Path x:Name="netGraphFill">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#55FB7185" Offset="0.0"/>
                                                <GradientStop Color="#05FB7185" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <Path x:Name="netGraphLine" Stroke="#FB7185" StrokeThickness="2"/>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
