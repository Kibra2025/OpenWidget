<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DeskHardwareWidget</RootNamespace>
    <AssemblyName>OpenWidget</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetFrameworkRootPath Condition="Exists('$(MSBuildProjectDirectory)\.build\reference-assemblies\build\.NETFramework\v4.8')">$(MSBuildProjectDirectory)\.build\reference-assemblies\build\</TargetFrameworkRootPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <WarningLevel>4</WarningLevel>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" /><Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Management" />
    <Reference Include="PresentationCore" /><Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" /><Reference Include="System.Xaml" />
    <Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" />
    <Reference Include="libs\*.dll"><Private>True</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml"><Generator>MSBuild:Compile</Generator></ApplicationDefinition>
    <Page Include="MainWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="GpuCard.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="SettingsWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="BatteryWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Page Include="BatteryCard.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Compile Include="App.xaml.cs"><DependentUpon>App.xaml</DependentUpon></Compile>
    <Compile Include="MainWindow.xaml.cs"><DependentUpon>MainWindow.xaml</DependentUpon></Compile>
    <Compile Include="GpuCard.xaml.cs"><DependentUpon>GpuCard.xaml</DependentUpon></Compile>
    <Compile Include="SettingsWindow.xaml.cs"><DependentUpon>SettingsWindow.xaml</DependentUpon></Compile>
    <Compile Include="BatteryWindow.xaml.cs"><DependentUpon>BatteryWindow.xaml</DependentUpon></Compile>
    <Compile Include="BatteryCard.xaml.cs"><DependentUpon>BatteryCard.xaml</DependentUpon></Compile>
    <Compile Include="BatteryMonitor.cs" />
    <Compile Include="LogitechHidTransport.cs" /><Compile Include="LogitechBatteryProvider.cs" />
    <Compile Include="DualSenseBatteryProvider.cs" />
    <Compile Include="Config.cs" /><Compile Include="Win32Helper.cs" /><Compile Include="AutostartManager.cs" /><Compile Include="HardwareMonitor.cs" />
    <Compile Include="Diagnostics.cs" /><Compile Include="GraphRenderer.cs" /><Compile Include="WindowPlacement.cs" /><Compile Include="AssemblyInfo.cs" />
    <None Include="app.config" /><None Include="app.manifest" />
    <Resource Include="Assets\App.ico" /><Resource Include="Assets\AppIcon.png" />
    <None Include="Assets\AppIcon.svg" />
    <Content Include="tools\PawnIO_setup.exe"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="licenses\*.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
