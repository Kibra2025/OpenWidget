<UserControl x:Class="DeskHardwareWidget.BatteryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="114" Height="176" FontFamily="Segoe UI">
        <StackPanel Margin="0,6,0,0">
            <Grid Width="88" Height="88" HorizontalAlignment="Center">
                <Ellipse x:Name="RingTrack" Stroke="#323645" StrokeThickness="7" Margin="4"/>
                <Ellipse x:Name="FullRing" StrokeThickness="7" Margin="4" Visibility="Collapsed"/>
                <Path x:Name="RingProgress" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="DeviceIcon" Stroke="#E2E4EC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="28" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="ChargingBadge" Background="#15161C" CornerRadius="9" Width="24" Height="27" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-4,0,0" Visibility="Collapsed">
                    <Path Data="M12,1 L3,12 H9 L7,23 18,9 H12 Z" Fill="#4ADE80" Width="16" Height="24" Stretch="Uniform"/>
                </Border>
                <Border x:Name="AcBadge" Background="#15161C" CornerRadius="8" Width="24" Height="25" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" Visibility="Collapsed">
                    <Path Data="M7,1 V7 M15,1 V7 M5,7 H17 V11 C17,15 5,15 5,11 Z M11,14 V21" Stroke="#38BDF8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="21" Stretch="Uniform"/>
                </Border>
            </Grid>
            <TextBlock x:Name="DeviceName" Foreground="#E2E4EC" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,8,4,0"/>
            <TextBlock x:Name="PercentText" Text="—" Foreground="White" FontSize="28" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="PowerStateText" Foreground="#94A3B8" FontSize="8" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,2,2,0"/>
        </StackPanel>
</UserControl>
